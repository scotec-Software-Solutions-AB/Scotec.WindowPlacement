<Window x:Class="WindowPlacement.Sample.Wpf.SampleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movable dialog" Width="530" Height="320" MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="20">
        <Button Content="Close" DockPanel.Dock="Bottom" Width="100" Height="30"
                HorizontalAlignment="Right" Margin="0,20,0,0" Click="Close_Click"/>
        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Move and resize this dialog"/>
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap">Its position is captured from the HWND when closing. On the next opening, the saved monitor-relative DPI-independent position is resolved against the available monitors and applied using WPF window properties.</TextBlock>
            <TextBlock Margin="0,18,0,0" Text="Close this dialog, then reopen it from the main window." TextWrapping="Wrap"/>
        </StackPanel>
    </DockPanel>
</Window>
